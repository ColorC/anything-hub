{
  "name": "anything-hub",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:web && npm run build:core",
    "build:web": "esbuild src/web/app.js --bundle --format=esm --target=es2022 --outfile=publish/web/app.js",
    "build:core": "esbuild src/server.mjs --bundle --platform=node --format=esm --target=node24 --outfile=publish/core/server.mjs",
    "start": "node publish/core/server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "html2canvas": "1.4.1",
    "parse5": "^8.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@playwright/test": "^1.56.1"
  }
}
